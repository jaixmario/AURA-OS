# Disk DescriptorFile
version=1
encoding="UTF-8"
CID=fffffffe
parentCID=ffffffff
isNativeSnapshot="no"
createType="monolithicFlat"

# Extent description (10 MB = 20480 sectors of 512 bytes)
RW 20480 FLAT "auraos.img" 0

# The Disk Data Base 
#DDB

ddb.adapterType = "ide"
ddb.geometry.cylinders = "40"
ddb.geometry.heads = "16"
ddb.geometry.sectors = "32"
ddb.virtualHWVersion = "4"
